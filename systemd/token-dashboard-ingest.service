[Unit]
Description=token-dashboard: refresh the Claude Code spend store (0 LLM tokens)
Documentation=https://github.com/kuhyx/control-panel

[Service]
Type=oneshot
# The ingester lives with the parser and price table it reuses
# (testsAndMisc/python_pkg/token_audit); this repo only reads its SQLite store.
WorkingDirectory=%h/src/testsAndMisc
Environment=PYTHONPATH=%h/src/testsAndMisc
ExecStart=/usr/bin/python3 -m python_pkg.token_dashboard.ingest --budget 45
# 75 = more transcripts pending (a backfill in progress); the next firing
# continues it. Not a failure.
SuccessExitStatus=75
TimeoutStartSec=120
Nice=19
IOSchedulingClass=idle
