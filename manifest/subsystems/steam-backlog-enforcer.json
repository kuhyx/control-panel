{
  "id": "steam-backlog-enforcer",
  "title": "Steam backlog enforcer",
  "category": "enforcement",
  "units": [
    {
      "name": "steam-backlog-enforcer.service",
      "scope": "system",
      "kind": "service",
      "why_it_matters": "3-second enforce loop; runs as root with OOMScoreAdjust=-900"
    },
    {
      "name": "steam-backlog-enforcer-web.service",
      "scope": "user",
      "kind": "service"
    }
  ],
  "probes": [],
  "logs": [
    {
      "id": "steam-enforcer",
      "kind": "journal",
      "unit": "steam-backlog-enforcer.service",
      "scope": "system"
    },
    {
      "id": "steam-audit",
      "kind": "file",
      "path": "~/.config/steam_backlog_enforcer/exception_audit.log"
    }
  ],
  "facts": {
    "note": "The daemon does not serve the web UI; steam-backlog-enforcer-web.service (user) runs `serve` on :8000."
  },
  "audits": [
    {
      "path": "~/.config/steam_backlog_enforcer/exception_audit.log",
      "label": "approved exceptions (reason column)"
    }
  ],
  "dashboards": [
    {
      "label": "Backlog UI",
      "url": "http://127.0.0.1:8000/"
    }
  ]
}
