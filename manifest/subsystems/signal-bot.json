      "restartable": true
    },
    {
      "name": "signal-bot-popes-site.service",
      "scope": "user",
      "kind": "service",
      "restartable": true
    },
    {
      "name": "signal-jsonrpc-rebind.service",
      "scope": "user",
      "kind": "service",
      "restartable": true
    },
    {
      "name": "signal-api-watchdog.timer",
      "scope": "user",
