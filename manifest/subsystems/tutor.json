{
  "id": "tutor",
  "title": "Tutor",
  "category": "enforcement",
  "units": [
    {
      "name": "tutor.service",
      "scope": "user",
      "kind": "service",
      "why_it_matters": "the PC worker the phone talks to over Firebase; down = phone shows PC offline"
    }
  ],
  "dashboards": [
    {
      "label": "Tutor",
      "url": "http://127.0.0.1:8778/app/",
      "on_demand": false
    }
  ],
  "logs": [
    {
      "id": "tutor",
      "kind": "file",
      "path": "~/.local/state/tutor/server.log"
    }
  ],
  "docs": [
    {
      "path": "~/src/tutor/README.md",
      "label": "tutor README (service: tutor.service; open: ~/src/tutor/run.sh)"
    }
  ]
}
